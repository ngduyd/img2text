# img2text environment (Plan G Task 1). Copy and fill:
#   cp deploy/.env.example deploy/.env
# Keys must match Settings fields exactly — server/tests/test_env_parity.py enforces both directions.

# --- Core ---
ENV=dev
DATABASE_URL=postgresql+asyncpg://img2text:img2text@postgres:5432/img2text
# POSTGRES_PASSWORD: compose postgres (service side). Absent = dev fallback img2text;
#   prod set a strong value (see Production block below). Not a Settings key.
# POSTGRES_PASSWORD=
# APP_SECRET: blank = dev placeholder; prod fail-fast (32+ random chars required)
APP_SECRET=
BASE_URL=http://localhost
# WORKER_BASE_URL: API base bake vào kernel Kaggle (reachable từ Kaggle network).
#   Rỗng → fallback BASE_URL. Prod: URL public (không localhost).
WORKER_BASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# RUNNER_KEY: blank = dev placeholder; prod fail-fast (not dev-runner-key)
RUNNER_KEY=
LOG_PATH=logs/img2text.log
# #15: RotatingFileHandler — 10MB × 7 bản (host deploys; container stdout)
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=7
# CORS: comma-separated regex origins joined with "|" (R58; VSCode forwards)
ALLOWED_ORIGINS=http://localhost:.*|http://127\.0\.0\.1:.*|https://[a-z0-9-]+\.vscode\.dev
# Scheduler claim/reap interval seconds, floor 5 (R58)
# Plan S: các key runtime (SCHEDULER/KAGGLE_MIN_*) override qua admin UI (Setting table); env = mặc định khi DB trống
SCHEDULER_INTERVAL_SECONDS=60
# Wave-5 S1: purge file gốc — tick interval (floor 60s) + retention (ngày)
PURGE_INTERVAL_SECONDS=3600
PURGE_RETENTION_DAYS=7
# #12: daily pg_dump — APScheduler cron expr ("min hour dom month dow"); override runtime qua Setting table. Retention = giữ N ngày.
BACKUP_CRON=0 4 * * *
BACKUP_RETENTION_DAYS=14
# Page cap cho PDF (P2-5: settings.max_pages; default 100)
MAX_PAGES=100
# Spec 2026-11-04: ToS version + lease động theo trang + cap lần reap
TOS_VERSION=2026-11-04
LEASE_BASE_MINUTES=20
LEASE_PER_PAGE_MINUTES=4
LEASE_CAP_MINUTES=90
JOB_PAGE_LEASE_MINUTES=10
JOB_MAX_ATTEMPTS=3
# P2 #19 (spec 2026-10-16): presigned expiry windows (giây) — crop 1h, input 15'
CROP_PRESIGN_EXPIRES=3600
INPUT_URL_EXPIRES=900
# Batch Kaggle: kernel chỉ tải input khi tới lượt GPU (hàng đợi free tier có lúc
# >15 phút) → presign riêng 6h cho manifest batch; worker claim vẫn 900s.
BATCH_INPUT_URL_EXPIRES=21600
# Session loop (spec 2026-10-16): quota còn lại tối thiểu để spawn (giây), tuổi tối đa 1 session
KAGGLE_SESSION_MIN_QUOTA_S=7200
KAGGLE_SESSION_MAX_AGE_S=30600

# --- Production ---
# P0 spec 2026-10-15: prod fail-fast guards (app_secret/runner_key/admin/LLM)
#   fire only when ENV=prod. Uncomment + fill ALL values below to deploy prod.
# WEB_PORT: host port cho nginx (mặc định 80). Docker rootless không bind được 80
#   → WEB_PORT=18080. Đổi port thì BASE_URL phải đổi theo.
# WEB_PORT=80
# IMG_TAG: chỉ dùng với deploy/docker-compose.images.yml (stack image dựng sẵn) —
#   tag git = version đã CI build. Bỏ trống → v0.3.0.
# IMG_TAG=v0.3.0
# ENV=prod
# APP_SECRET=<32+ random bytes>
# RUNNER_KEY=<32+ random bytes>
# ADMIN_EMAIL=admin@prod.example
# ADMIN_PASSWORD=<strong>
# LLM_BASE_URL=https://llm.example.com/v1
# WORKER_BASE_URL=https://api.prod.example   # URL public — kernel Kaggle gọi về (không localhost)
# POSTGRES_PASSWORD=<strong>
# ...other prod overrides...

# --- Kaggle worker orchestration (Plan K2; empty = disabled, no kaggle import) ---
# API creds: kaggle.com → Settings → API. KAGGLE_API_TOKEN is the kaggle 2.x
#   primary (recommended); empty token → legacy KAGGLE_KEY. Kernel ref of the
#   pre-created kernel (init once via deploy/kaggle/push.py — also creates the
#   dataset + Secrets).
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=
KAGGLE_KERNEL_REF=
KAGGLE_ACCELERATOR=NvidiaTeslaT4
# Orchestration mode: session (default — 1 kernel session claim→OCR→upload→done lặp)
#   | loop (Plan K2 worker kernel polling the backend — needs public BASE_URL + Secrets)
#   | batch = Plan K5 deprecated (rollback = flip env)
# predict nhiều trang cùng lúc trong kernel batch (đo thông lượng GPU)
KAGGLE_BATCH_PREDICT=false
KAGGLE_MODE=session
# Ceiling note only: kernels_push timeout kw unreliable; platform caps session
KAGGLE_TIMEOUT=10800
# KAGGLE_MIN_QUEUE: loop mode only (batch = 1 spawn/tick + single-active-run
#   guard, không cần queue threshold)
KAGGLE_MIN_QUEUE=1
# Min gap between spawns, both modes (anti-spam)
KAGGLE_MIN_GAP_SECONDS=600
# Batch one-run: max queued jobs staged into ONE kernel run (extra jobs wait
#   for the next tick; spec 2026-10-09)
KAGGLE_BATCH_MAX_JOBS=20
# Kernel source templates (repo deploy/kaggle; in container: /app/deploy/kaggle)
KAGGLE_STAGE_SRC=deploy/kaggle
KAGGLE_STAGE_DIR=/tmp/img2text-kaggle-kernel

# --- SMTP (password resets) ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- R2 object storage (uploads/ exports/); R2_PUBLIC_BASE reserved for public CDN domain ---
# Endpoint: R2_ENDPOINT trống → auto-build https://R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE=
# Optional public endpoint for presigned file links (browser-fetched URLs);
# empty = R2_ENDPOINT (prod R2 unchanged)
STORAGE_PUBLIC_ENDPOINT=

# --- Plan D2: LLM layout plan cho export docx-layout (OpenAI-compatible local) ---
# Plan M: docx-layout renderer nhận word style override từ jobs.layout_style
#   (JSON nullable, không env key mới) — migration xem docs/migrations/2026-11-03-missing-columns.sql.
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=role-scout
LLM_TIMEOUT=180
# IR rewrite + proofread dùng model riêng (cùng endpoint OpenAI-compatible)
# Số trang gọi LLM song song khi proofread (1 trang ~80-140s)
PROOFREAD_CONCURRENCY=3
PROOFREAD_LLM_MODEL=role-scout

# Bearer token cho LLM remote (/v1/chat/completions); rỗng = không auth
LLM_API_KEY=

# Đăng ký: SMTP chưa cấu hình thì không có cách nào verify email → tự verify
# ngay khi đăng ký (demo/dev). Đặt true cũng bật OCR cho user mới.
AUTO_VERIFY_EMAIL=false
# Đăng nhập Google (OAuth). Bỏ trống = ẩn nút Google. Redirect URI khai ở
# console.cloud.google.com: {BASE_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=

# CIDR proxy được tin để đọc X-Forwarded-For (mặc định: loopback + mạng riêng
# Docker/k8s). Đặt rỗng nếu API phơi trực tiếp ra internet.
TRUSTED_PROXIES=
