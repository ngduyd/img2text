# img2text environment (Plan G Task 1). Copy and fill:
#   cp deploy/.env.example deploy/.env
# Keys must match Settings fields exactly — server/tests/test_env_parity.py enforces both directions.

# --- Core ---
DATABASE_URL=postgresql+asyncpg://img2text:img2text@postgres:5432/img2text
APP_SECRET=change-me-long-random
BASE_URL=http://localhost
ADMIN_EMAIL=
ADMIN_PASSWORD=
RUNNER_KEY=change-me-runner-key
LOG_PATH=logs/img2text.log
# CORS: comma-separated regex origins joined with "|" (R58; VSCode forwards)
ALLOWED_ORIGINS=http://localhost:.*|http://127\.0\.0\.1:.*|https://[a-z0-9-]+\.vscode\.dev
# Scheduler claim/reap interval seconds, floor 5 (R58)
SCHEDULER_INTERVAL_SECONDS=60

# --- SMTP (password resets) ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- R2 object storage (uploads/ exports/); R2_PUBLIC_BASE reserved for public CDN domain ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE=
