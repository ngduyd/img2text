# img2text dev env (compose dev stack). Copy and fill:
#   cp deploy/.env.dev.example deploy/.env.dev
# Values below work out of the box with deploy/docker-compose.dev.yml.
# DATABASE_URL is OVERRIDDEN by docker-compose.dev.yml (compose service name
#   `postgres`, DB img2text_dev). The value here only matters if you run the
#   server on the host instead (README "Alternative: server on host").

# --- Core ---
APP_SECRET=dev-secret-change-me
BASE_URL=http://localhost:5173
RUNNER_KEY=dev-runner-key
ADMIN_EMAIL=admin@dev.local          # bootstraps the admin user on first server boot
ADMIN_PASSWORD=admin-dev-123

# --- Object storage (LocalStack S3, dev stand-in for R2; ruling R47) ---
# host.docker.internal resolves inside the server container via host-gateway
# (extra_hosts in docker-compose.dev.yml) → host :4566 → LocalStack. The host
# browser fetches presigned object URLs from the SAME URL: Docker Desktop
# resolves host.docker.internal natively; plain Linux hosts add one /etc/hosts
# line (host-gateway IP, e.g. `172.17.0.1 host.docker.internal`).
# Host-side tools that can't use that name (mc-style CLIs run on the host)
# reach LocalStack at http://localhost:4566 instead.
R2_ENDPOINT=http://host.docker.internal:4566
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET=img2text
R2_REGION=us-east-1
R2_PUBLIC_BASE=

# --- SMTP ---
# dev: reset emails no-op (mailer logs the failure, flow continues)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
