# img2text dev env (compose dev stack). Copy and fill:
#   cp deploy/.env.dev.example deploy/.env.dev
# Values below work out of the box with deploy/docker-compose.dev.yml.
# DATABASE_URL is OVERRIDDEN by docker-compose.dev.yml (compose service name
#   `postgres`, DB img2text_dev). The value here only matters if you run the
#   server on the host instead (README "Alternative: server on host").

# --- Core ---
APP_SECRET=dev-secret-change-me
BASE_URL=http://localhost:5173
# WORKER_BASE_URL: API base cho kernel Kaggle (public, reachable từ Kaggle).
#   Rỗng → fallback BASE_URL. Dev Vite :5173 không reach từ Kaggle → set public khi test.
WORKER_BASE_URL=
RUNNER_KEY=dev-runner-key
ADMIN_EMAIL=admin@dev.local          # bootstraps the admin user on first server boot
ADMIN_PASSWORD=admin-dev-123

# --- Kaggle worker orchestration (Plan K2) — set username + (key hoặc token) + kernel_ref to enable auto-spawn ---
# API creds: kaggle.com → Settings → API — KAGGLE_API_TOKEN khuyên dùng
#   (kaggle 2.x primary); empty → legacy KAGGLE_KEY. Kernel ref must pre-exist (init once
#   via deploy/kaggle/push.py — also creates the dataset + Secrets BASE_URL/RUNNER_KEY;
#   see deploy/kaggle/README.md). Quota free ~30h GPU/week.
# NOTE: compose dev server passes these through from deploy/.env or shell env
#   (compose `environment` overrides env_file — same as DATABASE_URL/R2_ENDPOINT);
#   the values below are for a HOST-side server (README alternative).
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=
KAGGLE_KERNEL_REF=
# session = mặc định (1 kernel session claim→OCR→upload→done lặp);
#   loop = Plan K2 (cần BASE_URL public + Secrets); batch = Plan K5 deprecated (rollback = flip env)
# Plan S: runtime override (min queue/gap, interval) qua admin UI (Setting table); env = mặc định khi DB trống
KAGGLE_MODE=batch          # dev: batch (stage dataset + push kernel); prod: session

# --- Object storage (LocalStack S3, dev stand-in for R2; ruling R47) ---
# Split endpoints (dev upload 500 fix):
#   R2_ENDPOINT — ops calls (put/head) from INSIDE the server container.
#     Compose dev OVERRIDES this to the in-network http://localstack:4566
#     (container→host-published :4566 times out on hosts with broken DNAT).
#     Value below is what a HOST-side server (README alternative) uses:
#     localhost works — the host reaches the published port directly.
#   STORAGE_PUBLIC_ENDPOINT — presigned file links fetched by the USER'S
#     BROWSER on the host → http://localhost:4566. Compose dev sets the same.
#     Empty = falls back to R2_ENDPOINT (prod R2 single-endpoint, unchanged).
R2_ENDPOINT=http://localhost:4566
STORAGE_PUBLIC_ENDPOINT=http://localhost:4566
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET=img2text
R2_REGION=us-east-1
R2_PUBLIC_BASE=

# --- SMTP ---
# dev: reset emails no-op (mailer logs the failure, flow continues)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# LLM layout plan (Plan D2, docx-layout export); dev server llm.cpp:20128
LLM_BASE_URL=http://localhost:20128/v1
# Bearer token cho LLM remote (/v1/chat/completions); rỗng = không auth
LLM_API_KEY=

# --- Còn lại: mặc định trong Settings (server/app/core/config.py) ---
# Chỉ cần khai báo ở đây khi muốn khác mặc định. Toàn bộ key runtime còn
# override được từ /admin (Setting row) mà không cần restart.
ENV=dev
ALLOWED_ORIGINS=http://localhost:.*|http://127\.0\.0\.1:.*|https://[a-z0-9-]+\.vscode\.dev
LLM_MODEL=role-scout
PROOFREAD_LLM_MODEL=role-scout
PROOFREAD_CONCURRENCY=3
LLM_TIMEOUT=180
MAX_PAGES=100

# Scheduler / lease
SCHEDULER_INTERVAL_SECONDS=60
PURGE_INTERVAL_SECONDS=3600
PURGE_RETENTION_DAYS=7
JOB_MAX_ATTEMPTS=3
JOB_PAGE_LEASE_MINUTES=10
LEASE_BASE_MINUTES=20
LEASE_PER_PAGE_MINUTES=4
LEASE_CAP_MINUTES=90

# Kaggle orchestration (bỏ trống nhóm KAGGLE_ phía trên = tắt hẳn tính năng)
KAGGLE_BATCH_MAX_JOBS=20
KAGGLE_BATCH_PREDICT=false
KAGGLE_MIN_GAP_SECONDS=120
KAGGLE_MIN_QUEUE=1
KAGGLE_TIMEOUT=10800
KAGGLE_ACCELERATOR=NvidiaTeslaT4
KAGGLE_SESSION_MIN_QUOTA_S=7200
KAGGLE_SESSION_MAX_AGE_S=30600
KAGGLE_STAGE_DIR=/tmp/img2text-kaggle-kernel
KAGGLE_STAGE_SRC=deploy/kaggle

# Presign TTL (giây)
INPUT_URL_EXPIRES=900
BATCH_INPUT_URL_EXPIRES=21600
CROP_PRESIGN_EXPIRES=3600

# Log / backup / điều khoản
LOG_PATH=logs/img2text.log
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=7
BACKUP_CRON=0 4 * * *
BACKUP_RETENTION_DAYS=14
TOS_VERSION=2026-11-04
R2_ACCOUNT_ID=
